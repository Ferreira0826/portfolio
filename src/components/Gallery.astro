---
// Galeria de screenshots do projeto.
// Mostra placeholders "em breve" quando a imagem ainda não foi adicionada.
const { shots = [] } = Astro.props;
---
{shots.length > 0 && (
  <section class="mb-16 reveal">
    <div class="font-mono text-[11px] text-faint tracking-widest mb-6">EM FUNCIONAMENTO</div>
    <div class="grid gap-4 sm:grid-cols-2">
      {shots.map((shot, i) => (
        shot.src ? (
          <figure class="group m-0">
            <button
              type="button"
              class="block w-full overflow-hidden rounded-xl border border-line bg-panel/60 cursor-zoom-in"
              data-lightbox={shot.src}
              data-caption={shot.caption}
            >
              <img
                src={shot.src}
                alt={shot.caption}
                loading="lazy"
                class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.02]"
              />
            </button>
            <figcaption class="font-mono text-[11px] text-faint mt-2">{shot.caption}</figcaption>
          </figure>
        ) : (
          <figure class="m-0">
            <div class="flex flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-line2 bg-panel/40 aspect-video text-center px-4">
              <svg class="w-7 h-7 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="m8 21 4-4 4 4M9 10a1.5 1.5 0 1 0 0-.01"/><path d="m3 15 5-4 4 3 3-2 6 5"/></svg>
              <span class="font-mono text-[11px] text-muted">screenshot em breve</span>
            </div>
            <figcaption class="font-mono text-[11px] text-faint mt-2">{shot.caption}</figcaption>
          </figure>
        )
      ))}
    </div>
  </section>
)}

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-base/90 backdrop-blur-sm p-6 cursor-zoom-out">
  <figure class="m-0 max-w-5xl w-full">
    <img id="lightbox-img" src="" alt="" class="w-full h-auto max-h-[80vh] object-contain rounded-lg border border-line2" />
    <figcaption id="lightbox-cap" class="font-mono text-xs text-muted text-center mt-3"></figcaption>
  </figure>
</div>

<script>
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img');
  const lbCap = document.getElementById('lightbox-cap');
  if (lb && lbImg && lbCap) {
    document.querySelectorAll('[data-lightbox]').forEach((btn) => {
      btn.addEventListener('click', () => {
        lbImg.src = btn.getAttribute('data-lightbox');
        lbCap.textContent = btn.getAttribute('data-caption') || '';
        lb.classList.remove('hidden');
        lb.classList.add('flex');
      });
    });
    const close = () => { lb.classList.add('hidden'); lb.classList.remove('flex'); lbImg.src = ''; };
    lb.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
</script>
