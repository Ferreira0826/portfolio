---
import Icon from './Icon.astro';
import { profile } from '../data/projects.js';
---
<header class="sticky top-0 z-50 border-b border-line bg-base/80 backdrop-blur-md">
  <div class="mx-auto max-w-content px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-mono text-sm text-ink hover:text-signal transition-colors">
      gabriel<span class="text-signal">.dev</span>
    </a>
    <nav class="flex items-center gap-6 font-mono text-[13px]">
      <a href="/#projetos" class="text-muted hover:text-ink transition-colors">projetos</a>
      <a href="/#sobre" class="text-muted hover:text-ink transition-colors">sobre</a>
      <a href="/#contato" class="text-muted hover:text-ink transition-colors">contato</a>
      <a href={profile.github} target="_blank" rel="noopener" class="flex items-center gap-1.5 text-muted hover:text-ink transition-colors">
        <Icon name="github" class="w-4 h-4" />
        <span class="hidden sm:inline">github</span>
      </a>
    </nav>
  </div>
</header>
